# 打包文件和目录
build/
dist/
# *.spec 文件保留，Windows 打包需要
!*.spec

# Python 缓存文件
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 虚拟环境
.venv/
venv/
env/

# IDE 文件
.vscode/
.idea/
*.swp
*.swo
*~

# 系统文件
.DS_Store
Thumbs.db

# 日志文件
*.log

# 临时文件
*.tmp
*.temp

# 图标文件（如果很大）
# icon/
images/*

# 文档文件
*.md
# 例外文件
!README.md
!CLAUDE.md

# 配置文件（包含 API 密钥）
config/model_settings.json
config/agent_memory.json

# 环境变量文件
.env
.env.local
.env.*.local
